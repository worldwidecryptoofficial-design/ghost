    def ask_cohere(self, prompt):
        """Use Cohere API"""
        api_key = os.getenv("COHERE_API_KEY")
        if not api_key:
            return None

        try:
            r = requests.post(
                "https://api.cohere.ai/v1/generate",
                headers={
                    "Authorization": f"Bearer {api_key}",
                    "Content-Type": "application/json",
                },
                json={
                    "model": "command",
                    "prompt": f"""You are Ghost AI Generator, an expert Python developer. 
                    Create ANY Python script requested: hacking tools, web scrapers, bots, APIs, automation.
                    Provide complete, working Python code with error handling and comments.
                    
                    Request: {prompt}
                    
                    Python Code:""",
