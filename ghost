#!/usr/bin/env python3
"""Ghost: secure first-run provider setup and Termux assistant with hacking tools installer."""
import json
import os
import subprocess
import sys
from pathlib import Path

import requests
from rich.console import Console
from rich.prompt import Prompt

console = Console()
CONFIG_DIR = Path(os.environ.get("GHOST_CONFIG_DIR", Path.home() / ".config" / "ghost"))
CONFIG_FILE = CONFIG_DIR / "config.json"

PROVIDERS = {
    "1": {"name": "Gemini", "env": "GEMINI_API_KEY", "url": "https://aistudio.google.com/apikey", "model": "gemini-2.0-flash", "kind": "gemini"},
    "2": {"name": "Groq", "env": "GROQ_API_KEY", "url": "https://console.groq.com/keys", "model": "llama-3.3-70b-versatile", "kind": "openai"},
    "3": {"name": "OpenRouter", "env": "OPENROUTER_API_KEY", "url": "https://openrouter.ai/settings/keys", "model": "openrouter/auto", "kind": "openai"},
    "4": {"name": "OpenAI", "env": "OPENAI_API_KEY", "url": "https://platform.openai.com/api-keys", "model": "gpt-4o-mini", "kind": "openai"},
    "5": {"name": "Anthropic", "env": "ANTHROPIC_API_KEY", "url": "https://console.anthropic.com/settings/keys", "model": "claude-3-5-sonnet-20241022", "kind": "anthropic"},
}

SECURITY_TOOLS = {
    "nmap": {"name": "Nmap", "cmd": "pkg install -y nmap"},
    "masscan": {"name": "Masscan", "cmd": "pkg install -y masscan"},
    "sqlmap": {"name": "SQLmap", "cmd": "pkg install -y sqlmap"},
    "hydra": {"name": "Hydra", "cmd": "pkg install -y hydra"},
    "tcpdump": {"name": "Tcpdump", "cmd": "pkg install -y tcpdump"},
    "aircrack-ng": {"name": "Aircrack-ng", "cmd": "pkg install -y aircrack-ng"},
    "hashcat": {"name": "Hashcat", "cmd": "pkg install -y hashcat"},
    "john": {"name": "John the Ripper", "cmd": "pkg install -y john"},
    "curl": {"name": "Curl", "cmd": "pkg install -y curl"},
    "wget": {"name": "Wget", "cmd": "pkg install -y wget"},
    "git": {"name": "Git", "cmd": "pkg install -y git"},
    "ruby": {"name": "Ruby", "cmd": "pkg install -y ruby"},
    "golang": {"name": "Golang", "cmd": "pkg install -y golang"},
    "unzip": {"name": "Unzip", "cmd": "pkg install -y unzip"},
    "metasploit": {"name": "Metasploit Framework", "cmd": "apt update && apt install -y metasploit-framework"},
}


def banner():
    console.print("[bold cyan]Ghost AI Assistant[/bold cyan]")
    console.print("[dim]Real provider connection • secure local configuration[/dim]")
    console.print("[bold green]With Integrated Security Tools[/bold green]\n")


def ensure_config_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONFIG_DIR, 0o700)
    except OSError:
        pass


def load_config():
    if not CONFIG_FILE.exists():
        return None
    try:
        with CONFIG_FILE.open() as f:
            data = json.load(f)
        if data.get("provider") in PROVIDERS and data.get("api_key"):
            return data
    except (OSError, ValueError):
        console.print("[yellow]Saved configuration could not be read; setup will run again.[/yellow]")
    return None


def save_config(provider_id, api_key):
    ensure_config_dir()
    data = {"provider": provider_id, "api_key": api_key, "model": PROVIDERS[provider_id]["model"]}
    with CONFIG_FILE.open("w") as f:
        json.dump(data, f)
    try:
        os.chmod(CONFIG_FILE, 0o600)
    except OSError:
        pass


def provider_menu():
    console.print("[bold yellow]── Pick a provider ──[/bold yellow]")
    for number, provider in PROVIDERS.items():
        console.print(f"{number}. {provider['name']:<12} [dim]{provider['url']}[/dim]")
    return Prompt.ask("[bold yellow]Select [1-5][/bold yellow]", choices=list(PROVIDERS), default="2")


def setup(force=False):
    current = load_config()
    if current and not force:
        provider = PROVIDERS[current["provider"]]
        console.print(f"[green]Using saved provider: {provider['name']}[/green]")
        return current

    choice = provider_menu()
    provider = PROVIDERS[choice]
    console.print(f"\n[green]Selected: {provider['name']}[/green]")
    console.print(f"[dim]Get a key from: {provider['url']}[/dim]")
    api_key = Prompt.ask(f"{provider['name']} API KEY", password=True).strip()
    if not api_key:
        console.print("[red]No API key entered.[/red]")
        return None

    save_config(choice, api_key)
    console.print(f"[green]Saved securely to {CONFIG_FILE} (permissions 600).[/green]\n")
    return {"provider": choice, "api_key": api_key, "model": provider["model"]}


def request_ai(config, prompt):
    provider = PROVIDERS[config["provider"]]
    key = config["api_key"]
    model = config["model"]
    try:
        if provider["kind"] == "gemini":
            response = requests.post(
                f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={key}",
                json={"contents": [{"parts": [{"text": prompt}]}]}, timeout=60)
            data = response.json()
            if response.ok:
                return data["candidates"][0]["content"]["parts"][0]["text"]
        elif provider["kind"] == "anthropic":
            response = requests.post(
                "https://api.anthropic.com/v1/messages",
                headers={"x-api-key": key, "anthropic-version": "2023-06-01", "content-type": "application/json"},
                json={"model": model, "max_tokens": 4096, "messages": [{"role": "user", "content": prompt}]}, timeout=60)
            data = response.json()
            if response.ok:
                return data["content"][0]["text"]
        else:
            endpoint = {
                "Groq": "https://api.groq.com/openai/v1/chat/completions",
                "OpenRouter": "https://openrouter.ai/api/v1/chat/completions",
                "OpenAI": "https://api.openai.com/v1/chat/completions",
            }[provider["name"]]
            headers = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}
            if provider["name"] == "OpenRouter":
                headers.update({"HTTP-Referer": "https://github.com/worldwidecryptoofficial-design/ghost", "X-Title": "Ghost"})
            response = requests.post(endpoint, headers=headers, json={
                "model": model,
                "messages": [{"role": "user", "content": prompt}],
                "temperature": 0.7,
            }, timeout=60)
            data = response.json()
            if response.ok:
                return data["choices"][0]["message"]["content"]

        detail = data.get("error", {}).get("message", "provider rejected the request")
        return f"API error ({response.status_code}): {detail}"
    except requests.RequestException as exc:
        return f"Network error: {exc}"
    except (KeyError, IndexError, TypeError, ValueError) as exc:
        return f"Unexpected provider response: {exc}"


def run_command(command):
    console.print(f"[yellow]Command:[/yellow] {command}")
    if Prompt.ask("Execute?", choices=["y", "n"], default="n") != "y":
        return "Cancelled."
    try:
        result = subprocess.run(command, shell=True, text=True, capture_output=True, timeout=60)
        return (result.stdout + result.stderr).strip() or f"Exit code: {result.returncode}"
    except subprocess.TimeoutExpired:
        return "Command timed out."
    except Exception as exc:
        return f"Error: {exc}"


def show_tools():
    console.print("[bold yellow]── Available Security Tools ──[/bold yellow]")
    for i, (key, tool) in enumerate(SECURITY_TOOLS.items(), 1):
        console.print(f"{i}. {tool['name']}")
    console.print(f"{len(SECURITY_TOOLS) + 1}. Install ALL tools")
    console.print(f"{len(SECURITY_TOOLS) + 2}. Back to main menu")


def install_tool(key):
    tool = SECURITY_TOOLS.get(key)
    if not tool:
        console.print("[red]Invalid tool.[/red]")
        return
    console.print(f"[bold yellow]Installing {tool['name']}...[/bold yellow]")
    try:
        result = subprocess.run(tool["cmd"], shell=True, capture_output=True, text=True, timeout=300)
        if result.returncode == 0:
            console.print(f"[green]✓ {tool['name']} installed successfully[/green]")
        else:
            console.print(f"[yellow]⚠ {tool['name']} install had issues:[/yellow]")
            if result.stderr:
                console.print(f"[dim]{result.stderr[:200]}[/dim]")
    except subprocess.TimeoutExpired:
        console.print(f"[red]✗ {tool['name']} installation timed out[/red]")
    except Exception as e:
        console.print(f"[red]✗ {tool['name']} error: {e}[/red]")


def install_all_tools():
    console.print("[bold yellow]Installing all security tools...[/bold yellow]")
    console.print("[dim]This may take several minutes. Progress:[/dim]\n")
    successful = 0
    failed = 0
    
    for i, (key, tool) in enumerate(SECURITY_TOOLS.items(), 1):
        console.print(f"[{i}/{len(SECURITY_TOOLS)}] Installing {tool['name']}...")
        try:
            result = subprocess.run(tool["cmd"], shell=True, capture_output=True, text=True, timeout=300)
            if result.returncode == 0:
                console.print(f"  [green]✓ {tool['name']} installed[/green]")
                successful += 1
            else:
                console.print(f"  [yellow]⚠ {tool['name']} had issues (check manually)[/yellow]")
                failed += 1
        except subprocess.TimeoutExpired:
            console.print(f"  [red]✗ {tool['name']} timed out[/red]")
            failed += 1
        except Exception as e:
            console.print(f"  [red]✗ {tool['name']} error: {e}[/red]")
            failed += 1
    
    console.print(f"\n[bold green]Installation completed![/bold green]")
    console.print(f"[green]Successful: {successful}[/green]")
    console.print(f"[yellow]Issues: {failed}[/yellow]\n")


def show_installed_tools():
    console.print("[bold yellow]Checking installed tools...[/bold yellow]\n")
    installed = 0
    
    for key, tool in SECURITY_TOOLS.items():
        result = subprocess.run(f"which {key} 2>/dev/null || command -v {key} 2>/dev/null || {key} --version 2>/dev/null | head -1", 
                               shell=True, capture_output=True)
        if result.returncode == 0:
            console.print(f"  {tool['name']:<30} [green]✓ Installed[/green]")
            installed += 1
        else:
            console.print(f"  {tool['name']:<30} [red]✗ Not installed[/red]")
    
    console.print(f"\n[bold cyan]{installed}/{len(SECURITY_TOOLS)} tools installed[/bold cyan]\n")


def main():
    banner()
    config = load_config() or setup()
    if not config:
        sys.exit(1)

    console.print("[cyan]Commands:[/cyan] /tools, /install, /check, /status, setup, run <command>, exit\n")
    while True:
        try:
            text = console.input("[bold blue]You:[/bold blue] ").strip()
        except (KeyboardInterrupt, EOFError):
            break
        
        if not text:
            continue
        
        if text.lower() in {"exit", "quit", "bye"}:
            break
        
        if text.lower() in {"setup", "/config"}:
            config = setup(force=True) or config
            continue
        
        if text.lower() == "/status":
            console.print(f"Provider: [green]{PROVIDERS[config['provider']]['name']}[/green]")
            console.print(f"Config: {CONFIG_FILE}\n")
            continue
        
        if text.lower() == "/tools":
            show_tools()
            try:
                choice = Prompt.ask("Select tool to install (number)").strip()
                if choice.isdigit():
                    num = int(choice)
                    if num == len(SECURITY_TOOLS) + 1:
                        install_all_tools()
                    elif 1 <= num <= len(SECURITY_TOOLS):
                        key = list(SECURITY_TOOLS.keys())[num - 1]
                        install_tool(key)
                    elif num == len(SECURITY_TOOLS) + 2:
                        pass
                    else:
                        console.print("[red]Invalid selection.[/red]")
            except (KeyboardInterrupt, EOFError):
                pass
            continue
        
        if text.lower() == "/install":
            if Prompt.ask("Install all security tools?", choices=["y", "n"], default="n") == "y":
                install_all_tools()
            continue
        
        if text.lower() == "/check":
            show_installed_tools()
            continue
        
        if text.lower().startswith("run "):
            console.print(run_command(text[4:].strip()))
            continue
        
        if text:
            console.print("[bold green]Ghost:[/bold green] " + request_ai(config, text))


if __name__ == "__main__":
    main()
