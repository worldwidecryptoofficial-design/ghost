    console.print(f"{len(SECURITY_TOOLS) + 1}. Install ALL tools")
    console.print(f"{len(SECURITY_TOOLS) + 2}. Back to main menu")


def install_tool(key):
    """Install one missing security tool inside the connected Kali environment."""
    tool = SECURITY_TOOLS.get(key)

    if not tool:
        console.print("[red]Unknown Kali tool.[/red]")
        return

    status = kali_tool_status()
    executables = tool.get("exes", [])

    # Aircrack-ng and John may expose alternate executable names.
    if key in ("aircrack-ng", "john"):
        installed = any(
            status.get(exe, {}).get("installed", False)
            for exe in executables
        )
    else:
        installed = all(
            status.get(exe, {}).get("installed", False)
            for exe in executables
        )

    if installed:
        console.print(
            f"[green]✓ {tool['name']} is already installed inside Kali.[/green]"
        )
        return

    console.print(
        f"[cyan]Installing {tool['name']} inside Kali...[/cyan]"
    )

    try:
        result = subprocess.run(
            ["apt-get", "install", "-y", tool["package"]],
            capture_output=True,
            text=True,
            timeout=900,
        )

        if result.returncode == 0:
            console.print(
                f"[green]✓ {tool['name']} installed inside Kali.[/green]"
            )
        else:
            output = (
                result.stderr or result.stdout or ""
            ).strip()

            console.print(
                f"[red]✗ Could not install {tool['name']} from the current Kali user.[/red]"
            )

            if output:
                console.print(f"[dim]{output[-600:]}[/dim]")

            console.print(
                f"[yellow]If root installation is required, run:[/yellow]"
            )
            console.print(
                f"[bold]nethunter -r apt-get install -y {tool['package']}[/bold]"
            )

    except subprocess.TimeoutExpired:
        console.print(
            f"[red]✗ Installation timed out for {tool['name']}.[/red]"
        )
    except Exception as exc:
        console.print(f"[red]✗ Installation error: {exc}[/red]")


def install_all_tools():
    """Check all logical tools and install only those missing from Kali."""
    if not nethunter_available():
        console.print("[red]NetHunter/Kali is not available.[/red]")
        return

    console.print("[bold cyan]── Kali / NetHunter Installation ──[/bold cyan]")
    console.print("[dim]Checking the connected Kali environment...[/dim]")
    console.print()

    status = kali_tool_status()
    missing = []

    for key, tool in SECURITY_TOOLS.items():
        executables = tool.get("exes", [])

        if key in ("aircrack-ng", "john"):
            installed = any(
                status.get(exe, {}).get("installed", False)
                for exe in executables
            )
        else:
            installed = all(
                status.get(exe, {}).get("installed", False)
                for exe in executables
            )

        if installed:
            console.print(
                f"  [green]✓ {tool['name']:<22} already installed[/green]"
            )
        else:
            console.print(
                f"  [yellow]⚠ {tool['name']:<22} missing[/yellow]"
            )
            missing.append(key)

    if not missing:
        console.print()
        console.print(
            "[bold green]All 16 logical tools are already installed inside Kali.[/bold green]"
        )
        return

    console.print()
    console.print(
        f"[yellow]{len(missing)} tool(s) require installation.[/yellow]"
    )

    for key in missing:
        install_tool(key)

    console.print()
    console.print("[cyan]Run /check to verify the Kali inventory.[/cyan]")


def show_installed_tools():
    """Show the 16 logical security tools and their Kali installation status."""
    if not nethunter_available():
        console.print("[red]NetHunter is not available.[/red]")
        return

    status = kali_tool_status()

    console.print()
    console.print("[bold cyan]── Kali Security Tools ──[/bold cyan]")

    total = len(SECURITY_TOOLS)
    installed_count = 0

    for key, tool in SECURITY_TOOLS.items():
        executables = tool.get("exes", [])

        if not executables:
            installed = False
        elif key in ("aircrack-ng", "john"):
            # These packages may expose different executable names
            # depending on the Kali package/version.
            installed = any(
                status.get(exe, {}).get("installed", False)
                for exe in executables
            )
        else:
            installed = all(
                status.get(exe, {}).get("installed", False)
                for exe in executables
            )

        if installed:
            console.print(
                f"  [green]✓ {tool['name']:<22} installed in Kali[/green]"
            )
            installed_count += 1
        else:
            console.print(
                f"  [red]✗ {tool['name']:<22} missing from Kali[/red]"
            )

    console.print()
    console.print(
        f"[bold green]{installed_count}/{total} logical tools detected inside NetHunter[/bold green]"
    )

def show_nethunter_status():
    console.print("[bold yellow]── NetHunter Bridge ──[/bold yellow]")

    if not nethunter_available():
        console.print("[red]✗ nethunter/nh not found[/red]")
        return

    status = kali_status()

    if status.get("connected"):
        console.print("[green]✓ Ghost → NetHunter → Kali connected[/green]")
        console.print("[dim]Kali environment is responding.[/dim]")
    else:
        console.print("[yellow]⚠ NetHunter found but Kali did not respond.[/yellow]")

    console.print()



def main():
    banner()
    config = load_config() or setup()
    if not config:
        sys.exit(1)

    console.print("[cyan]Commands:[/cyan] /install, /check, /nh, /kali <tool>, /status, setup, run <command>, exit\n")
    while True:
        try:
            text = console.input("[bold blue]You:[/bold blue] ").strip()
        except (KeyboardInterrupt, EOFError):
            break
        
        if not text:
            continue
        
        if text.lower() in {"exit", "quit", "bye"}:
            break
        
        if text.lower() in {"setup", "/config"}:
            config = setup(force=True) or config
            continue
        
        if text.lower() == "/status":
            console.print(f"Provider: [green]{PROVIDERS[config['provider']]['name']}[/green]")
            console.print(f"Config: {CONFIG_FILE}\n")
            continue
        
        if text.lower() == "/install":
            if Prompt.ask("Install all security tools?", choices=["y", "n"], default="n") == "y":
                install_all_tools()
            continue
        
        if text.lower() == "/check":
            show_installed_tools()
            continue
        
        if text.lower() == "/nh":
            ok, status = kali_status()
            if ok:
                console.print("[green]✓ NetHunter/Kali connected[/green]")
                console.print(status)

                tools = kali_tool_status()
                installed = sum(
                    1 for info in tools.values()
                    if info.get("installed")
                )
                total = len(tools)

                console.print(
                    f"\n[cyan]Kali tools: "
                    f"[green]{installed}/{total} detected[/green][/cyan]"
                )
            else:
                console.print("[red]✗ NetHunter/Kali unavailable[/red]")
                console.print(status)
            continue

        if text.lower() == "/kali":
            console.print()
            console.print("[bold cyan]── Kali Security Bridge ──[/bold cyan]")
            console.print("[green]Status: CONNECTED[/green]")
            console.print()
            console.print("[cyan]Available diagnostic tools:[/cyan]")

            for tool_name, tool in SECURITY_TOOLS.items():
                console.print(f"  /kali {tool_name}")

            console.print()
            console.print(
                "[dim]Only predefined diagnostic/version checks are available.[/dim]"
            )
            continue

        if text.lower().startswith("/kali "):
            tool = text[6:].strip()

            if not tool:
                console.print("[yellow]Usage: /kali <tool>[/yellow]")
                continue

            allowed = {
                "nmap": ("nmap", ["--version"]),
                "masscan": ("masscan", ["--version"]),
                "sqlmap": ("sqlmap", ["--version"]),
                "hydra": ("hydra", ["-h"]),
                "tcpdump": ("tcpdump", ["--version"]),
                "aircrack-ng": ("aircrack-ng", ["--version"]),
                "hashcat": ("hashcat", ["--version"]),
                "john": ("john", ["--version"]),
                "curl": ("curl", ["--version"]),
                "wget": ("wget", ["--version"]),
                "git": ("git", ["--version"]),
                "python3": ("python3", ["--version"]),
                "ruby": ("ruby", ["--version"]),
                "golang": ("go", ["version"]),
                "unzip": ("unzip", ["--version"]),
                "metasploit": ("msfconsole", ["--version"]),
            }

            if tool not in allowed:
                console.print(
                    "[yellow]Tool not available for diagnostic execution.[/yellow]"
                )
                console.print(
                    "Use /check to see the detected Kali tools."
                )
                continue

            executable, args = allowed[tool]
            command = executable + " " + " ".join(args)

            ok, output = run_kali_safe(command)

            if ok:
                console.print(f"[green]✓ {tool} responded[/green]")
                console.print(output)
            else:
                console.print(f"[red]✗ {tool} diagnostic failed[/red]")
                if output:
                    console.print(output)
                console.print(output)

            continue

        if text.lower().startswith("run "):
            console.print(run_command(text[4:].strip()))
            continue
        
        if text:
            console.print("[bold green]Ghost:[/bold green] " + request_ai(config, text))


if __name__ == "__main__":
    main()
