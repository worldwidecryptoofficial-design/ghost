                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json"
            },
            json={
                "model": "mixtral-8x7b-32768",
                "messages": [
                    {"role": "system", "content": "You are Ghost, a helpful Termux and Python assistant. Provide clear, practical answers."},
                    {"role": "user", "content": prompt}
