        ("OpenAI", ask_openai),
        ("Groq", ask_groq),
        ("Claude (Anthropic)", ask_anthropic),
        ("Cohere", ask_cohere),
        ("Gemini", ask_gemini),
    ]

    for name, provider in providers:
        console.print(f"[bold yellow]Trying {name}...[/bold yellow]")
        result = provider(prompt)
        if result:
            console.print(f"[bold green]Response from {name}[/bold green]")
            return result

    return (
        "Ghost needs API keys.\n"
        "Set at least one:\n"
        "export OPENAI_API_KEY='...'\n"
        "export GROQ_API_KEY='...'\n"
        "export ANTHROPIC_API_KEY='...'\n"
        "export COHERE_API_KEY='...'\n"
        "export GEMINI_API_KEY='...'\n"
    )

def run_command(cmd):
    """Execute shell commands"""
    try:
        result = subprocess.run(
            cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=30
        )
        return result.stdout + result.stderr
    except subprocess.TimeoutExpired:
        return "Command timed out."
    except Exception as e:
        return f"Error: {e}"

def create_and_run_python(code):
    """Create a Python script and run it"""
    try:
        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
            f.write(code)
            script_path = f.name

        console.print(f"[bold yellow]Script created:[/bold yellow] {script_path}")
        result = subprocess.run(
            f"python3 {script_path}",
            shell=True,
            capture_output=True,
            text=True,
            timeout=30
        )
        output = result.stdout + result.stderr
        
        os.remove(script_path)
        return output
    except Exception as e:
        return f"Error: {e}"

def save_python(code, filename):
    """Save Python script to a file"""
    try:
        with open(filename, 'w') as f:
            f.write(code)
        os.chmod(filename, 0o755)
        console.print(f"[bold green]Saved to:[/bold green] {filename}")
        return f"Script saved to {filename}"
    except Exception as e:
        return f"Error saving: {e}"

def main():
    os.system("clear")
    print_banner()

    console.print("[bold cyan]Commands:[/bold cyan]")
    console.print("  Ask Ghost to create Python scripts or tools")
    console.print("  'run <command>' - execute shell commands")
    console.print("  'create <name.py>' - Ghost creates and saves a Python script")
    console.print("  'exec <name.py>' - run a saved Python script")
    console.print("  'exit' - quit\n")
    console.print("[bold cyan]AI Providers:[/bold cyan] OpenAI, Groq, Claude, Cohere, Gemini\n")

    while True:
        try:
            user = console.input("[bold blue]You:[/bold blue] ")
        except KeyboardInterrupt:
            console.print("\n[bold yellow]Ghost: session closed.[/bold yellow]")
            break

        if user.strip().lower() in ["exit", "quit", "bye"]:
            console.print("[bold yellow]Ghost: goodbye.[/bold yellow]")
            break

        if user.strip().lower().startswith("run "):
            cmd = user[4:].strip()
            console.print(f"[bold yellow]Executing:[/bold yellow] {cmd}")
            output = run_command(cmd)
            console.print(f"[bold green]Output:[/bold green]\n{output}")
        
        elif user.strip().lower().startswith("exec "):
            script = user[5:].strip()
            if os.path.exists(script):
                console.print(f"[bold yellow]Running:[/bold yellow] {script}")
                output = run_command(f"python3 {script}")
                console.print(f"[bold green]Output:[/bold green]\n{output}")
            else:
                console.print(f"[bold red]File not found:[/bold red] {script}")
        
        else:
            reply = ask_ai(user)
            console.print("[bold green]Ghost:[/bold green]\n" + reply)
            
            try:
                save = console.input("[bold yellow]Save as Python script? (y/filename):[/bold yellow] ")
                if save.lower() == 'y':
                    filename = "ghost_script.py"
                    save_python(reply, filename)
                elif save and not save.lower() == 'n':
                    save_python(reply, save)
            except KeyboardInterrupt:
                pass
        
        print()

if __name__ == "__main__":
    main()
