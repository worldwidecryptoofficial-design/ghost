def ensure_config_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONFIG_DIR, 0o700)
    except OSError:
        pass


def load_config():
    if not CONFIG_FILE.exists():
        return None
    try:
        with CONFIG_FILE.open() as f:
            data = json.load(f)
        if data.get("provider") in PROVIDERS and data.get("api_key"):
            return data
    except (OSError, ValueError):
        console.print("[yellow]Saved configuration could not be read; setup will run again.[/yellow]")
    return None


def save_config(provider_id, api_key):
    ensure_config_dir()
    data = {"provider": provider_id, "api_key": api_key, "model": PROVIDERS[provider_id]["model"]}
    with CONFIG_FILE.open("w") as f:
        json.dump(data, f)
    try:
        os.chmod(CONFIG_FILE, 0o600)
    except OSError:
        pass


def provider_menu():
    console.print("[bold yellow]── Pick a provider ──[/bold yellow]")
    for number, provider in PROVIDERS.items():
        console.print(f"{number}. {provider['name']:<12} [dim]{provider['url']}[/dim]")
    return Prompt.ask("[bold yellow]Select [1-5][/bold yellow]", choices=list(PROVIDERS), default="2")


def setup(force=False):
    current = load_config()
    if current and not force:
        provider = PROVIDERS[current["provider"]]
        console.print(f"[green]Using saved provider: {provider['name']}[/green]")
        return current

    choice = provider_menu()
    provider = PROVIDERS[choice]
    console.print(f"\n[green]Selected: {provider['name']}[/green]")
    console.print(f"[dim]Get a key from: {provider['url']}[/dim]")
    api_key = Prompt.ask(f"{provider['name']} API KEY", password=True).strip()
    if not api_key:
        console.print("[red]No API key entered.[/red]")
        return None

    save_config(choice, api_key)
    console.print(f"[green]Saved securely to {CONFIG_FILE} (permissions 600).[/green]\n")
    return {"provider": choice, "api_key": api_key, "model": provider["model"]}


def request_ai(config, prompt):
    # Automatically verify freshness-sensitive software/security facts.
    freshness = verify_freshness(prompt)
    verification_context = build_verification_context(freshness)

    if verification_context:
        prompt = f"""
You are Ghost AI.

For freshness-sensitive software information, authoritative verification
takes priority over model memory.

{verification_context}

USER REQUEST:
{prompt}

Answer accurately and concisely.
Never invent release numbers, changelog entries, or software features.
If the verification result is unavailable, explicitly say that current
information could not be verified.
"""

    provider = PROVIDERS[config["provider"]]
    key = config["api_key"]
    model = config["model"]
    try:
        if provider["kind"] == "gemini":
            response = requests.post(
                f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={key}",
                json={"contents": [{"parts": [{"text": prompt}]}]}, timeout=60)
            data = response.json()
            if response.ok:
                return data["candidates"][0]["content"]["parts"][0]["text"]
        elif provider["kind"] == "anthropic":
            response = requests.post(
                "https://api.anthropic.com/v1/messages",
                headers={"x-api-key": key, "anthropic-version": "2023-06-01", "content-type": "application/json"},
                json={"model": model, "max_tokens": 4096, "messages": [{"role": "user", "content": prompt}]}, timeout=60)
            data = response.json()
            if response.ok:
                return data["content"][0]["text"]
        else:
            endpoint = {
                "Groq": "https://api.groq.com/openai/v1/chat/completions",
                "OpenRouter": "https://openrouter.ai/api/v1/chat/completions",
                "OpenAI": "https://api.openai.com/v1/chat/completions",
            }[provider["name"]]
            headers = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}
            if provider["name"] == "OpenRouter":
                headers.update({"HTTP-Referer": "https://github.com/worldwidecryptoofficial-design/ghost", "X-Title": "Ghost"})
            response = requests.post(endpoint, headers=headers, json={
                "model": model,
                "messages": [{"role": "user", "content": prompt}],
                "temperature": 0.7,
            }, timeout=60)
            data = response.json()
            if response.ok:
                return data["choices"][0]["message"]["content"]

        detail = data.get("error", {}).get("message", "provider rejected the request")
        return f"API error ({response.status_code}): {detail}"
    except requests.RequestException as exc:
        return f"Network error: {exc}"
    except (KeyError, IndexError, TypeError, ValueError) as exc:
        return f"Unexpected provider response: {exc}"


def run_command(command):
    """
    Controlled diagnostic command runner.
    Natural-language requests are accepted only for
    explicitly local/test targets.
    """
    import re
    import shlex

    command = command.strip()

    if not command:
        return "No command supplied."

    diagnostic_args = {
        "nmap": ["--version"],
        "masscan": ["--version"],
        "sqlmap": ["--version"],
        "hydra": ["-h"],
        "tcpdump": ["--version"],
        "aircrack-ng": ["--version"],
        "hashcat": ["--version"],
        "john": ["--version"],
        "curl": ["--version"],
        "wget": ["--version"],
        "git": ["--version"],
        "python3": ["--version"],
        "ruby": ["--version"],
        "go": ["version"],
        "unzip": ["--version"],
        "msfconsole": ["--version"],
        "msfvenom": ["--version"],
    }

    try:
        parts = shlex.split(command)
    except ValueError as exc:
        return f"Invalid command syntax: {exc}"

    if not parts:
        return "No command supplied."

    executable = parts[0].lower()

    if executable not in diagnostic_args:
        return (
            "Command rejected: only tools in Ghost's managed "
            "Kali diagnostic inventory are available."
        )

    # Exact diagnostic request.
    if len(parts) == 1:
        parts = [executable] + diagnostic_args[executable]

    # Permit only explicit local/test targets for scan-style requests.
    local_targets = {"localhost", "127.0.0.1", "::1", "my-lab", "my_lab"}

    target = None
    match = re.search(
        r"\b(?:against|target|host)\s+([A-Za-z0-9_.:-]+)",
        command,
        re.IGNORECASE,
    )

    if match:
        target = match.group(1)

    scan_words = re.search(
        r"\b(scan|scanning|probe|discover)\b",
        command,
        re.IGNORECASE,
    )

    if scan_words:
        if target not in local_targets:
            return (
                "Scan request blocked: Ghost only permits explicitly "
                "configured local/test targets."
            )

        # Controlled local test only.
        if executable == "nmap":
            parts = ["nmap", target, "--version"]
            return (
                "Test target recognized, but the current bridge is "
                "diagnostic-only. Use 'run nmap' for the version test."
            )

    expected = [executable] + diagnostic_args[executable]

    if parts != expected:
        return (
            f"Command rejected: only the predefined diagnostic "
            f"command is allowed: {' '.join(expected)}"
        )

    if not nethunter_available():
        return "NetHunter is not available."

    console.print(f"[yellow]Kali tool:[/yellow] {executable}")
    console.print(
        f"[dim]NetHunter will execute: {' '.join(parts)}[/dim]"
    )

    if Prompt.ask(
        "Execute through NetHunter?",
        choices=["y", "n"],
        default="n",
    ) != "y":
        return "Cancelled."

    try:
        ok, output = run_kali_safe(" ".join(parts))

        if ok:
            return output or "Command completed successfully."

        return f"NetHunter execution error: {output}"

    except Exception as exc:
        return f"NetHunter execution error: {exc}"



