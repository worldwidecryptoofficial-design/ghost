def ask_ai(prompt, provider_choice):
    """Ask selected AI provider"""
    if provider_choice == "1":
        api_key = os.getenv("GEMINI_API_KEY")
        if api_key:
            return ask_gemini(prompt, api_key)
    elif provider_choice == "2":
        api_key = os.getenv("GROQ_API_KEY")
        if api_key:
            return ask_groq(prompt, api_key)
    elif provider_choice == "3":
        api_key = os.getenv("OPENROUTER_API_KEY")
        if api_key:
            return ask_openrouter(prompt, api_key)
    elif provider_choice == "4":
        api_key = os.getenv("OPENAI_API_KEY")
        if api_key:
            return ask_openai(prompt, api_key)
    elif provider_choice == "5":
        api_key = os.getenv("ANTHROPIC_API_KEY")
        if api_key:
            return ask_anthropic(prompt, api_key)
    
    return "[bold red]No API key configured for this provider.[/bold red]"

def run_command(cmd):
    """Execute shell commands"""
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30)
        return result.stdout + result.stderr
    except subprocess.TimeoutExpired:
        return "[bold red]Command timed out[/bold red]"
    except Exception as e:
        return f"[bold red]Error: {e}[/bold red]"

def main():
    # Check if API key is already set
    provider_choice = None
    for choice, provider in PROVIDERS.items():
        if os.getenv(provider["env"]):
            provider_choice = choice
            break
    
    # If no key is set, show selection menu
    if not provider_choice:
        provider_choice = show_provider_selection()
        provider = get_api_key_for_provider(provider_choice)
        if not provider:
            sys.exit(1)
    
    # Main loop
    os.system("clear")
    print_banner()
    
    console.print("[bold cyan]Commands:[/bold cyan]")
    console.print("  Ask any question")
    console.print("  'run <command>' - execute shell commands")
    console.print("  'setup' - change AI provider")
    console.print("  'exit' - quit\n")
    
    while True:
        try:
            user = console.input("[bold blue]You:[/bold blue] ").strip()
        except KeyboardInterrupt:
            console.print("\n[bold yellow]Ghost: session closed.[/bold yellow]")
            break
        
        if not user:
            continue
        
        if user.lower() in ["exit", "quit", "bye"]:
            console.print("[bold yellow]Ghost: goodbye.[/bold yellow]")
            break
        
        if user.lower() == "setup":
            provider_choice = show_provider_selection()
            provider = get_api_key_for_provider(provider_choice)
            if provider:
                console.print(f"[bold green]✓ Provider changed to {provider['name']}[/bold green]")
            continue
        
        if user.lower().startswith("run "):
            cmd = user[4:].strip()
            console.print(f"[bold yellow]Executing:[/bold yellow] {cmd}")
            result = run_command(cmd)
            console.print(f"[bold green]Output:[/bold green]\n{result}\n")
            continue
        
        # Ask AI
        reply = ask_ai(user, provider_choice)
        console.print(f"[bold green]Ghost:[/bold green] {reply}\n")

if __name__ == "__main__":
    main()
