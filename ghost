def show_provider_selection():
    """Show provider selection menu"""
    os.system("clear")
    print_banner()
    
    console.print("[bold cyan]No backend yet. Set one now (works with no opencode installed):[/bold cyan]")
    console.print("[yellow]Set a provider\n[/yellow]")
    
    for key, provider in PROVIDERS.items():
        console.print(f"  {key}. {provider['name']:20} - {provider['url']}")
    
    console.print()
    return Prompt.ask("[bold yellow]Select [1-5][/bold yellow]", default="2")

def get_api_key_for_provider(choice):
    """Get API key for selected provider"""
    if choice not in PROVIDERS:
        console.print("[bold red]Invalid choice.[/bold red]")
        return None
    
    provider = PROVIDERS[choice]
    os.system("clear")
    print_banner()
    
    console.print(f"[bold green]✓ Selected: {provider['name']}[/bold green]\n")
    console.print(f"[cyan]Get your API key from: {provider['url']}[/cyan]\n")
    
    api_key = Prompt.ask(f"[bold yellow]{provider['name']} API KEY[/bold yellow]", password=False)
    
    if not api_key or api_key.strip() == "":
        console.print("[bold red]No key provided.[/bold red]")
        return None
    
    # Set environment variable
    os.environ[provider["env"]] = api_key.strip()
    
    # Ask to save to bashrc
    save = Prompt.ask("[bold yellow]Save to ~/.bashrc? (y/n)[/bold yellow]", default="y")
    if save.lower() == "y":
        try:
            bashrc_path = os.path.expanduser("~/.bashrc")
            with open(bashrc_path, "a") as f:
                f.write(f'\nexport {provider["env"]}="{api_key.strip()}"\n')
            console.print(f"[bold green]✓ Saved {provider['name']} key to ~/.bashrc[/bold green]\n")
        except Exception as e:
            console.print(f"[bold red]Could not save to ~/.bashrc: {e}[/bold red]\n")
    
    return provider

def ask_gemini(prompt, api_key):
    """Ask Gemini API"""
    try:
        url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key={api_key}"
        r = requests.post(
            url,
            headers={"Content-Type": "application/json"},
            json={
                "contents": [{"parts": [{"text": prompt}]}],
                "generationConfig": {"temperature": 0.7, "maxOutputTokens": 2048}
            },
            timeout=30
        )
        if r.status_code == 200:
            return r.json()["candidates"][0]["content"]["parts"][0]["text"].strip()
        else:
            return f"[bold red]Gemini API error: {r.status_code}[/bold red]"
    except Exception as e:
        return f"[bold red]Gemini request failed: {e}[/bold red]"

