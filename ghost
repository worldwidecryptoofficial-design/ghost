def ask_openai(prompt):
    """Use OpenAI API"""
    api_key = os.getenv("OPENAI_API_KEY")
    if not api_key:
        return None

    try:
        r = requests.post(
            "https://api.openai.com/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json",
            },
            json={
                "model": "gpt-4o-mini",
                "messages": [
                    {"role": "system", "content": "You are Ghost, a Termux and Python expert. You can write Python scripts, create tools, hacking utilities, and Linux commands. When asked to create something, provide complete, working Python code. Be practical and direct."},
                    {"role": "user", "content": prompt},
                ],
                "temperature": 0.7,
            },
            timeout=30,
        )
        if r.status_code == 200:
            data = r.json()
            return data["choices"][0]["message"]["content"].strip()
    except Exception as e:
        pass
    return None

