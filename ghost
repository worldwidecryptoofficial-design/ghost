    console.print("  'exit' - quit\n")

    while True:
        try:
            user = console.input("[bold blue]You:[/bold blue] ")
        except KeyboardInterrupt:
            console.print("\n[bold yellow]Ghost: session closed.[/bold yellow]")
            break

        if user.strip().lower() in ["exit", "quit", "bye"]:
            console.print("[bold yellow]Ghost: goodbye.[/bold yellow]")
            break
        
        if user.strip().lower() == "setup":
            setup = GhostSetup()
            setup.setup_provider()
            continue

        if user.strip().lower().startswith("run "):
            cmd = user[4:].strip()
            console.print(f"[bold yellow]Executing:[/bold yellow] {cmd}")
            try:
                result = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30)
                console.print(f"[bold green]Output:[/bold green]\n{result.stdout + result.stderr}")
            except Exception as e:
                console.print(f"[bold red]Error:[/bold red] {e}")
        else:
            reply = ask_ai(user)
            if reply:
                console.print("[bold green]Ghost:[/bold green] " + reply)
            else:
                console.print("[bold red]No API key configured. Type 'setup' to configure.[/bold red]")
        
        print()

